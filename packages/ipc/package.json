{
  "name": "@evoplug/ipc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./schemas/*": "./dist/schemas/*.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "dependencies": {
    "@evoplug/core": "workspace:*",
    "@evoplug/ledger": "workspace:*",
    "@evoplug/budget": "workspace:*",
    "@evoplug/auth": "workspace:*",
    "@evoplug/egress": "workspace:*",
    "@evoplug/delivery": "workspace:*"
  }
}
