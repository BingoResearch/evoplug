{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:task_outcome_record:1",
  "title": "TaskOutcomeRecord",
  "description": "Append-only task outcome revision plus success evidence (DD-FND-054/074).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_id",
    "task_id",
    "branch_id",
    "binding",
    "revision",
    "outcome",
    "success_evidence_refs",
    "uncovered_requirement_ids",
    "pending_work",
    "reason_code",
    "boundary_event_id",
    "decided_at",
    "outcome_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "rsi.task_outcome/2"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^out:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "branch_id": {
      "type": "string",
      "pattern": "^br:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "binding": {
      "$ref": "#/$defs/VersionBinding"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "enum": [
        "active",
        "paused",
        "cancelled",
        "ended_unverified",
        "succeeded",
        "failed"
      ]
    },
    "success_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRef"
      }
    },
    "uncovered_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^req:[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "pending_work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingWorkItem"
      }
    },
    "reason_code": {
      "enum": [
        "none",
        "no_success_evidence",
        "pending_work",
        "human_cancel",
        "human_pause",
        "external_blocker",
        "verification_failed",
        "scope_uncovered",
        "version_stale",
        "boundary_unstable"
      ]
    },
    "boundary_event_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ev:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "decided_at": {
      "type": "integer",
      "minimum": 0
    },
    "outcome_hash": {
      "$ref": "#/$defs/Hash"
    }
  },
  "$defs": {
    "Hash": {
      "title": "Hash",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SourceRef": {
      "title": "SourceRef",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^journal://ev:[0-9A-HJKMNP-TV-Z]{26}#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
        },
        {
          "type": "string",
          "pattern": "^blob://sha256:[0-9a-f]{64}#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
        }
      ]
    },
    "VersionBinding": {
      "title": "VersionBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "branch_id",
        "input_epoch",
        "goal_version",
        "config_version",
        "watermark"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "input_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "goal_version": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "watermark": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PendingWorkItem": {
      "title": "PendingWorkItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "reason_code"
      ],
      "properties": {
        "kind": {
          "enum": [
            "issue",
            "review",
            "write",
            "delivery",
            "verification",
            "human_decision"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reason_code": {
          "enum": [
            "queued",
            "in_progress",
            "awaiting_human",
            "awaiting_evidence"
          ]
        }
      }
    },
    "HumanAttestation": {
      "title": "HumanAttestation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability_id",
        "evidence_ref",
        "confirmed_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "host_verified_interactive_user",
            "control_plane_explicit_confirmation"
          ]
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "confirmed_at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SuccessEvidence": {
      "title": "SuccessEvidence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_id",
        "task_id",
        "branch_id",
        "kind",
        "source_event_id",
        "source_ref",
        "producer_ref",
        "producer_kind",
        "covered_requirement_ids",
        "binding",
        "human_attestation",
        "attestation_subject_hash",
        "verified_at",
        "recorded_at",
        "recorded_at_watermark",
        "evidence_hash",
        "row_version"
      ],
      "properties": {
        "schema_version": {
          "const": "rsi.success_evidence/2"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^sev:[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "task_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "human_acceptance",
            "test_pass",
            "artifact_check",
            "external_verification"
          ]
        },
        "source_event_id": {
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "producer_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "producer_kind": {
          "enum": [
            "human",
            "test_runner",
            "artifact_checker",
            "external_verifier"
          ]
        },
        "covered_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding": {
          "$ref": "#/$defs/VersionBinding"
        },
        "human_attestation": {
          "oneOf": [
            {
              "$ref": "#/$defs/HumanAttestation"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation_subject_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verified_at": {
          "type": "integer",
          "minimum": 0
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0
        },
        "recorded_at_watermark": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_hash": {
          "$ref": "#/$defs/Hash"
        },
        "row_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "x-evoplug-ddl": {
    "table": "task_outcome",
    "enums": {
      "outcome": [
        "active",
        "paused",
        "cancelled",
        "ended_unverified",
        "succeeded",
        "failed"
      ],
      "reason_code": [
        "none",
        "no_success_evidence",
        "pending_work",
        "human_cancel",
        "human_pause",
        "external_blocker",
        "verification_failed",
        "scope_uncovered",
        "version_stale",
        "boundary_unstable"
      ]
    }
  }
}
