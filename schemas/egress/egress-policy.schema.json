{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:egress_policy:1",
  "title": "EgressPolicy",
  "description": "Default-deny network egress policy (DD-FND-093). secret is never allowed even if configured.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "default_decision", "endpoints", "project_exclusions", "max_source_refs", "permission_for_replay"],
  "properties": {
    "schema_version": { "const": "rsi.egress_policy/1" },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "default_decision": { "const": "deny" },
    "endpoints": { "type": "array", "items": { "$ref": "#/$defs/EgressEndpointRule" } },
    "project_exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "max_source_refs": { "type": "integer", "minimum": 0 },
    "permission_for_replay": { "enum": ["same_policy", "deny"] }
  },
  "$defs": {
    "DataClass": { "title": "DataClass", "enum": ["public", "user_text", "source_code", "tool_output", "secret"] },
    "EgressEndpointRule": {
      "title": "EgressEndpointRule",
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "port", "path_prefix", "models", "data_classes", "max_request_bytes"],
      "properties": {
        "scheme": { "const": "https" },
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path_prefix": { "type": "string", "pattern": "^/" },
        "models": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "data_classes": { "type": "array", "items": { "enum": ["public", "user_text", "source_code", "tool_output"] } },
        "max_request_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    }
  }
}
