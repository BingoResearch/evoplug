{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:ingest_receipt:1",
  "title": "IngestReceipt",
  "description": "event.ingest ACK (DD-FND-071). The watermark is a receipt boundary, not proof of model processing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_key", "commit_seq", "watermark", "duplicate", "task_id", "branch_id", "session_id", "goal_version", "config_version"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^ev:[0-9A-HJKMNP-TV-Z]{26}$" },
    "event_key": { "$ref": "#/$defs/Hash" },
    "commit_seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "watermark": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "duplicate": { "type": "boolean" },
    "task_id": { "type": "string", "pattern": "^task:[0-9A-HJKMNP-TV-Z]{26}$" },
    "branch_id": { "type": "string", "pattern": "^br:[0-9A-HJKMNP-TV-Z]{26}$" },
    "session_id": { "type": "string", "pattern": "^sess:[0-9A-HJKMNP-TV-Z]{26}$" },
    "input_id": { "type": "string", "pattern": "^input:[0-9A-HJKMNP-TV-Z]{26}$" },
    "input_epoch": { "type": "integer", "minimum": 1 },
    "goal_version": { "type": "string" },
    "config_version": { "type": "string" }
  },
  "$defs": {
    "Hash": { "title": "Hash", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
