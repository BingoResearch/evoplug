{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:review_enqueue_envelope:1",
  "title": "ReviewEnqueueEnvelopeV1",
  "description": "REV V1 structural envelope (DD-REV-010). HOST ReviewEnqueueRequest is a domain refinement of this schema; no second schema resource exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "trigger_event_id",
    "trigger_kind",
    "review_scope_key",
    "boundary_key",
    "signal_digest",
    "trigger_dedupe_key",
    "stable_event_ids",
    "stable_watermark",
    "goal_version",
    "scope",
    "pending_state",
    "pending_work_refs",
    "stable",
    "stable_evidence_ref",
    "policy_ref",
    "origin",
    "capability_snapshot_hash",
    "budget_policy_ref",
    "review_kind",
    "authorization_ref",
    "snapshot_request",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "rsi.review_enqueue/1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trigger_event_id": {
      "$ref": "#/$defs/TriggerEventId"
    },
    "trigger_kind": {
      "enum": [
        "new_input",
        "tool_fact",
        "compaction",
        "task_boundary_candidate",
        "task_stable",
        "session_end",
        "user_review_request",
        "experience_trigger",
        "config_signal"
      ]
    },
    "review_scope_key": {
      "$ref": "#/$defs/Hash"
    },
    "boundary_key": {
      "$ref": "#/$defs/Hash"
    },
    "signal_digest": {
      "$ref": "#/$defs/Hash"
    },
    "trigger_dedupe_key": {
      "$ref": "#/$defs/Hash"
    },
    "stable_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stable_watermark": {
      "type": "integer",
      "minimum": 0
    },
    "goal_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "$ref": "#/$defs/TriggerScope"
    },
    "pending_state": {
      "enum": [
        "none",
        "pending",
        "unknown"
      ]
    },
    "pending_work_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingWorkRef"
      }
    },
    "stable": {
      "type": "boolean"
    },
    "stable_evidence_ref": {
      "$ref": "#/$defs/SourceRef"
    },
    "policy_ref": {
      "$ref": "#/$defs/TriggerPolicyRef"
    },
    "origin": {
      "$ref": "#/$defs/TriggerOrigin"
    },
    "capability_snapshot_hash": {
      "$ref": "#/$defs/Hash"
    },
    "budget_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "review_kind": {
      "enum": [
        "auto",
        "explicit"
      ]
    },
    "authorization_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/GrantId"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_request": {
      "oneOf": [
        {
          "$ref": "#/$defs/StableSnapshotRequest"
        },
        {
          "$ref": "#/$defs/StagedSnapshotRequest"
        }
      ]
    },
    "supersedes_job_id": {
      "$ref": "#/$defs/JobId"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SourceRef": {
      "type": "string",
      "pattern": "^(journal|blob)://[^#]+#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
    },
    "TriggerEventId": {
      "type": "string",
      "pattern": "^trg:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "GrantId": {
      "type": "string",
      "pattern": "^grant:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "JobId": {
      "type": "string",
      "pattern": "^job:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PendingWorkRef": {
      "title": "PendingWorkRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_id",
        "kind",
        "state",
        "evidence_ref"
      ],
      "properties": {
        "pending_id": {
          "type": "string",
          "pattern": "^pen:[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "enum": [
            "delivery",
            "review_defer",
            "generation_resume"
          ]
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TriggerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "branch_id",
        "input_epoch",
        "goal_version",
        "config_version"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "input_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "goal_version": {
          "type": "string",
          "minLength": 1
        },
        "config_version": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TriggerPolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "policy_hash",
        "scope_key"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^pol:[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_hash": {
          "$ref": "#/$defs/Hash"
        },
        "scope_key": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "TriggerOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "evidence_kind",
        "suppress_automatic"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "host_auto",
            "evaluator",
            "evaluator_descendant",
            "unknown"
          ]
        },
        "evidence_kind": {
          "enum": [
            "session_registry",
            "host_field",
            "input_source_label",
            "invocation_context",
            "none"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "registry_entry_id": {
          "type": "string",
          "minLength": 1
        },
        "ancestor_run_id": {
          "type": "string",
          "minLength": 1
        },
        "suppress_automatic": {
          "type": "boolean"
        }
      }
    },
    "StableSnapshotRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "completeness",
        "missing_evidence_refs"
      ],
      "properties": {
        "mode": {
          "const": "stable"
        },
        "completeness": {
          "const": "complete"
        },
        "missing_evidence_refs": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      }
    },
    "StagedSnapshotRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "completeness",
        "missing_evidence_refs"
      ],
      "properties": {
        "mode": {
          "const": "explicit_stage"
        },
        "completeness": {
          "const": "staged_with_gaps"
        },
        "missing_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      }
    }
  }
}
