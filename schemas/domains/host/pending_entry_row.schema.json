{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:host_pending_entry_row:1",
  "title": "PendingEntryPhysicalRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pending_id", "owner", "object_type", "row_version", "record_state", "pending_key",
    "kind", "pending_state", "task_id", "branch_id", "input_epoch", "goal_version",
    "config_version", "watermark", "host_id", "mode", "config_space", "trigger_event_id",
    "deadline_at", "attempt", "created_at", "updated_at", "session_ref",
    "boundary_event_ref", "delivery_target_hash", "boundary_key", "review_job_id",
    "source_refs_json", "content_hash"
  ],
  "properties": {
    "pending_id": { "type": "string", "pattern": "^pen:" },
    "owner": { "const": "host" },
    "object_type": { "const": "pending_entry" },
    "row_version": { "type": "integer", "minimum": 1 },
    "record_state": { "const": "recorded" },
    "pending_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kind": { "enum": ["delivery", "review_defer", "generation_resume"] },
    "pending_state": { "type": "string" },
    "task_id": { "type": "string", "minLength": 1 },
    "branch_id": { "type": "string", "minLength": 1 },
    "input_epoch": { "type": "integer", "minimum": 1 },
    "goal_version": { "type": "string", "minLength": 1 },
    "config_version": { "type": "string", "minLength": 1 },
    "watermark": { "type": "integer", "minimum": 0 },
    "host_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "config_space": { "type": "string", "minLength": 1 },
    "trigger_event_id": { "type": ["string", "null"] },
    "deadline_at": { "type": ["integer", "null"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "integer", "minimum": 0 },
    "session_ref": { "type": ["string", "null"] },
    "boundary_event_ref": { "type": ["string", "null"] },
    "delivery_target_hash": { "type": ["string", "null"] },
    "boundary_key": { "type": ["string", "null"] },
    "review_job_id": { "type": ["string", "null"] },
    "source_refs_json": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
