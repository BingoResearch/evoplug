{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:host_human_confirmation_row:1",
  "title": "HostHumanConfirmationPhysicalRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confirmation_id", "binding_key", "binding_json", "host_binding_json",
    "event_identity_key", "challenge_nonce", "probe_id", "state", "evidence_ref",
    "created_at", "confirmed_at", "updated_at", "row_version"
  ],
  "properties": {
    "confirmation_id": { "type": "string", "minLength": 1 },
    "binding_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "binding_json": { "type": "string" },
    "host_binding_json": { "type": "string" },
    "event_identity_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "challenge_nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
    "probe_id": { "type": "string", "pattern": "^prb:" },
    "state": { "enum": ["pending", "confirmed", "failed", "expired"] },
    "evidence_ref": { "type": ["string", "null"] },
    "created_at": { "type": "integer", "minimum": 0 },
    "confirmed_at": { "type": ["integer", "null"] },
    "updated_at": { "type": "integer", "minimum": 0 },
    "row_version": { "type": "integer", "minimum": 1 }
  }
}
