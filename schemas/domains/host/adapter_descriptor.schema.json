{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:host_adapter_descriptor:1",
  "title": "AdapterDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "host_id", "adapter_version", "implementation_hash", "supported_modes", "config_spaces", "registration_targets", "event_contracts", "declared_capabilities"],
  "properties": {
    "schema_version": { "const": "rsi.adapter_descriptor/1" },
    "adapter_id": { "type": "string", "pattern": "^adp:" },
    "host_id": { "enum": ["pi", "oh-my-pi", "step-code", "codex", "opencode", "openhands-sdk", "claude-code"] },
    "adapter_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "implementation_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["interactive", "print", "rpc", "acp", "sdk", "sdk_stdio", "exec", "app-server", "server", "local_conversation", "remote_conversation"] }
    },
    "config_spaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
    },
    "registration_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "config_space", "scope", "kind", "load_boundary", "marker_id"],
        "properties": {
          "target_id": { "type": "string", "minLength": 1 },
          "config_space": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "scope": { "enum": ["user", "project", "managed"] },
          "kind": { "enum": ["extension", "plugin", "hook_config", "sdk_package"] },
          "load_boundary": { "enum": ["next_request", "reload", "new_session", "restart", "unknown"] },
          "marker_id": { "type": ["string", "null"] }
        }
      }
    },
    "event_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_event", "native_kind", "canonical_kinds", "required_capabilities"],
        "properties": {
          "host_event": { "type": "string", "minLength": 1 },
          "native_kind": { "type": "string", "minLength": 1 },
          "canonical_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "required_capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "declared_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
