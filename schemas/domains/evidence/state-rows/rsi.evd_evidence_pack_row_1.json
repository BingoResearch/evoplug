{
  "$id": "urn:evoplug:schema:evd_evidence_pack_row:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Physical row of evd_evidence_pack (DD-EVD-024); values are the frozen row_json columns.",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "content_bytes": {
      "maximum": 33554432,
      "minimum": 1,
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_ref": {
      "pattern": "^blob://",
      "type": "string"
    },
    "created_at": {
      "minimum": 0,
      "type": "integer"
    },
    "evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "goal_version": {
      "type": "string"
    },
    "input_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "issue_id": {
      "type": "string"
    },
    "issue_key": {
      "type": "string"
    },
    "pack_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "pack_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "pack_state": {
      "enum": [
        "valid",
        "invalidated"
      ],
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "row_version": {
      "const": 0,
      "type": "integer"
    },
    "source_blob_refs": {
      "description": "JCS text; JSON array",
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "watermark": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "pack_id",
    "pack_key",
    "pack_hash",
    "evidence_hash",
    "plan_id",
    "plan_hash",
    "issue_id",
    "issue_key",
    "pack_state",
    "content_hash",
    "content_ref",
    "content_bytes",
    "source_blob_refs",
    "row_version",
    "created_at",
    "task_id",
    "branch_id",
    "input_epoch",
    "goal_version",
    "config_version",
    "watermark"
  ],
  "title": "EvdEvidencePackRow",
  "type": "object"
}
