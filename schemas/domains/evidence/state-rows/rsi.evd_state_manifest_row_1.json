{
  "$id": "urn:evoplug:schema:evd_state_manifest_row:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Physical row of evd_state_manifest (DD-EVD-024); values are the frozen row_json columns.",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "content_bytes": {
      "maximum": 33554432,
      "minimum": 1,
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_ref": {
      "pattern": "^blob://",
      "type": "string"
    },
    "created_at": {
      "minimum": 0,
      "type": "integer"
    },
    "goal_version": {
      "type": "string"
    },
    "input_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_id": {
      "type": "string"
    },
    "manifest_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "pack_key": {
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "row_version": {
      "const": 0,
      "type": "integer"
    },
    "shard_id": {
      "type": "string"
    },
    "shard_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_blob_refs": {
      "description": "JCS text; JSON array",
      "type": "string"
    },
    "state_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "watermark": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "manifest_id",
    "manifest_key",
    "manifest_hash",
    "shard_id",
    "shard_key",
    "plan_id",
    "plan_hash",
    "pack_key",
    "state_hash",
    "state_content_hash",
    "content_hash",
    "content_ref",
    "content_bytes",
    "source_blob_refs",
    "row_version",
    "created_at",
    "task_id",
    "branch_id",
    "input_epoch",
    "goal_version",
    "config_version",
    "watermark"
  ],
  "title": "EvdStateManifestRow",
  "type": "object"
}
