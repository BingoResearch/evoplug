    },
    "estimate_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "estimate_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "goal_version": {
      "type": "string"
    },
    "input_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "limits_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "row_version": {
      "const": 0,
      "type": "integer"
    },
    "service_profile_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "shard_id": {
      "type": "string"
    },
    "shard_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
