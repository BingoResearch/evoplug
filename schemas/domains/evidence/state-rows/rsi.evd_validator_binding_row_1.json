      "type": "integer"
    },
    "row_version": {
      "const": 0,
      "type": "integer"
    },
    "service_profile_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "validator_binding_id": {
      "type": "string"
    },
    "validator_binding_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "validator_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
