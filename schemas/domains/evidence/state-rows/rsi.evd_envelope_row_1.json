{
  "$id": "urn:evoplug:schema:evd_envelope_row:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Physical row of evd_envelope (DD-EVD-024); values are the frozen row_json columns.",
  "properties": {
    "attempt_id": {
      "type": "string"
    },
    "binding_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "content_bytes": {
      "maximum": 33554432,
      "minimum": 1,
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_ref": {
      "pattern": "^blob://",
      "type": "string"
    },
    "created_at": {
      "minimum": 0,
      "type": "integer"
    },
    "dispatch_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "envelope_id": {
      "type": "string"
    },
    "envelope_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "goal_version": {
      "type": "string"
    },
    "input_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "received_at": {
      "minimum": 0,
      "type": "integer"
    },
    "request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "row_version": {
      "const": 0,
      "type": "integer"
    },
    "shard_id": {
      "type": "string"
    },
    "shard_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_blob_refs": {
      "description": "JCS text; JSON array",
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "accepted",
        "degraded"
      ],
      "type": "string"
    },
    "watermark": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "envelope_id",
    "envelope_key",
    "binding_id",
    "attempt_id",
    "request_hash",
    "dispatch_key",
    "shard_id",
    "shard_key",
    "validation_status",
    "received_at",
    "content_hash",
    "content_ref",
    "content_bytes",
    "source_blob_refs",
    "row_version",
    "created_at",
    "task_id",
    "branch_id",
    "input_epoch",
    "goal_version",
    "config_version",
    "watermark"
  ],
  "title": "EvdEnvelopeRow",
  "type": "object"
}
