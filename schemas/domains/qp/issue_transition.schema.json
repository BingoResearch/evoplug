{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:issue_transition:1",
  "title": "IssueTransitionRecord",
  "description": "QP append-only issue transition (DD-QP-04a, DD-QP-05).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "issue_id",
    "expected_version",
    "issue_version",
    "from_state",
    "to_state",
    "event",
    "evidence_refs",
    "judgment_ref",
    "payload_hash",
    "content_hash",
    "task_id",
    "branch_id",
    "recorded_at",
    "issue_after"
  ],
  "properties": {
    "schema_version": {
      "const": "rsi.issue_transition/1"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issue_id": {
      "type": "string"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "issue_version": {
      "type": "integer",
      "minimum": 1
    },
    "from_state": {
      "enum": [
        "none",
        "proposed",
        "open",
        "needs_evidence",
        "judged",
        "abstained",
        "closed",
        "stale_goal",
        "rejected"
      ]
    },
    "to_state": {
      "enum": [
        "proposed",
        "open",
        "needs_evidence",
        "judged",
        "abstained",
        "closed",
        "stale_goal",
        "rejected"
      ]
    },
    "event": {
      "enum": [
        "propose",
        "confirm",
        "reject",
        "require_evidence",
        "supply_evidence",
        "judge",
        "abstain",
        "reopen_evidence",
        "close",
        "reopen",
        "review_handoff_close",
        "review_handoff_reject",
        "invalidate_goal",
        "reject_issue",
        "attach_evidence"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/SourceRef"
      }
    },
    "judgment_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload_hash": {
      "$ref": "#/$defs/Hash"
    },
    "content_hash": {
      "$ref": "#/$defs/Hash"
    },
    "task_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "recorded_at": {
      "type": "integer",
      "minimum": 0
    },
    "issue_after": {
      "type": "object",
      "description": "Full canonical rsi.issue/1 projection (see issue.schema.json).",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SourceRef": {
      "type": "string",
      "pattern": "^(journal://ev:[0-9A-HJKMNP-TV-Z]{26}|blob://sha256:[0-9a-f]{64})#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
    }
  }
}
