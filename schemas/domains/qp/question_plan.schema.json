{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:question_plan:1",
  "title": "QuestionPlan",
  "description": "Immutable plan record; plan_state is separate and append-only (DD-QP-20, DD-QP-21).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_hash",
    "planner_version",
    "issue_id",
    "issue_key",
    "issue_type",
    "issue_version",
    "binding",
    "state_profile",
    "registry_version",
    "registry_hash",
    "artifact_paths",
    "sources",
    "questions",
    "dependencies",
    "required_source_ids",
    "required_views",
    "aggregate_output_reserve_tokens",
    "planned_at"
  ],
  "properties": {
    "schema_version": {
      "const": "rsi.question_plan/1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "plan_hash": {
      "$ref": "#/$defs/Hash"
    },
    "planner_version": {
      "const": "qp.planner/1"
    },
    "issue_id": {
      "type": "string"
    },
    "issue_key": {
      "$ref": "#/$defs/Hash"
    },
    "issue_type": {
      "type": "string"
    },
    "issue_version": {
      "type": "integer",
      "minimum": 1
    },
    "binding": {
      "$ref": "#/$defs/VersionBinding"
    },
    "state_profile": {
      "enum": [
        "progress_issue",
        "experience_review"
      ]
    },
    "registry_version": {
      "type": "string"
    },
    "registry_hash": {
      "$ref": "#/$defs/Hash"
    },
    "artifact_paths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/PlanSource"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/PlannedQuestion"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Dependency"
      }
    },
    "required_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_views": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "aggregate_output_reserve_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "planned_at": {
      "type": "integer",
      "minimum": 0
    },
    "supersedes_plan_id": {
      "type": "string"
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SourceRef": {
      "type": "string",
      "pattern": "^(journal://ev:[0-9A-HJKMNP-TV-Z]{26}|blob://sha256:[0-9a-f]{64})#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
    },
    "VersionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "branch_id",
        "input_epoch",
        "goal_version",
        "config_version",
        "watermark"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "branch_id": {
          "type": "string"
        },
        "input_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "goal_version": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        },
        "watermark": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PlanSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "source_refs",
        "content_hash",
        "version",
        "subject",
        "fact_kind",
        "fact_value_hash",
        "role",
        "retrievable",
        "requirement_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "requirement",
            "feedback",
            "fact",
            "code",
            "interface_contract",
            "call",
            "result",
            "diff",
            "test",
            "message",
            "experience",
            "comparison",
            "coverage",
            "task_condition",
            "unverified_constraint"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "fact_kind": {
          "enum": [
            "code",
            "interface_contract",
            "call",
            "result",
            "diff",
            "test",
            "message",
            null
          ]
        },
        "fact_value_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "support",
            "counter",
            "context",
            "definition",
            "target"
          ]
        },
        "retrievable": {
          "type": "boolean"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_key",
        "question_keys",
        "role",
        "transport_role",
        "selection_rank",
        "source_ids",
        "source_refs",
        "content_hash",
        "inseparable_group_key",
        "relation",
        "omission_impact",
        "can_omit",
        "derived_view_key"
      ],
      "properties": {
        "dependency_key": {
          "type": "string",
          "pattern": "^dep:[0-9a-f]{64}$"
        },
        "question_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hash"
          }
        },
        "role": {
          "type": "string"
        },
        "transport_role": {
          "enum": [
            "requirement",
            "feedback",
            "artifact",
            "verifier",
            "counter",
            "history",
            "context"
          ]
        },
        "selection_rank": {
          "type": "integer",
          "minimum": 0
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "inseparable_group_key": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "counter",
            "context",
            "defines",
            "derived"
          ]
        },
        "omission_impact": {
          "enum": [
            "answer_changing",
            "none"
          ]
        },
        "can_omit": {
          "type": "boolean"
        },
        "derived_view_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PlannedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question_id",
        "question_key",
        "slot",
        "issue_id",
        "issue_type",
        "question_type",
        "template_id",
        "template_version",
        "template_hash",
        "instructions",
        "criteria",
        "options",
        "required_views",
        "required_source_ids",
        "requirement_ids",
        "proposition_id",
        "option_effects",
        "answer_to_issue_map",
        "required_for_issue",
        "independence",
        "output_reserve_tokens",
        "wire_question"
      ],
      "properties": {
        "schema_version": {
          "const": "rsi.judge_question/1"
        },
        "question_id": {
          "type": "string",
          "pattern": "^q\\.(intent|behavior|step|acceptance|experience)\\."
        },
        "question_key": {
          "$ref": "#/$defs/Hash"
        },
        "slot": {
          "type": "string",
          "maxLength": 2
        },
        "issue_id": {
          "type": "string"
        },
        "issue_type": {
          "type": "string"
        },
        "question_type": {
          "const": "choice"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "template_hash": {
          "$ref": "#/$defs/Hash"
        },
        "instructions": {
          "type": "string"
        },
        "criteria": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 255,
          "items": {
            "type": "string"
          }
        },
        "required_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposition_id": {
          "type": "string",
          "pattern": "^propo:[0-9a-f]{64}$"
        },
        "option_effects": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "supports",
              "contradicts",
              "unknown"
            ]
          }
        },
        "answer_to_issue_map": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "required_for_issue": {
          "const": true
        },
        "independence": {
          "$ref": "#/$defs/Independence"
        },
        "output_reserve_tokens": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "wire_question": {
          "$ref": "#/$defs/WireQuestion"
        }
      }
    },
    "Independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_independent",
        "state_profile",
        "shareable"
      ],
      "properties": {
        "answer_independent": {
          "const": true
        },
        "state_profile": {
          "enum": [
            "progress_issue",
            "experience_review"
          ]
        },
        "shareable": {
          "type": "boolean"
        }
      }
    },
    "WireQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "instructions": {
          "type": "string"
        },
        "criteria": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
