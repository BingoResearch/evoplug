{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:issue:1",
  "title": "Issue",
  "description": "QP issue record (DD-QP-04). Instances are append-only; state changes only through rsi.issue_transition/1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issue_id", "issue_version", "issue_key", "binding", "type", "state",
    "subject_key", "question_text", "requirement_ids", "artifact_paths", "artifact_versions",
    "contract_required", "contract_paths", "trigger", "source_event_ids", "source_refs",
    "evidence_gap", "reopen_count", "opened_at_watermark", "last_observed_watermark",
    "created_at", "updated_at", "last_transition_id"
  ],
  "properties": {
    "schema_version": { "const": "rsi.issue/1" },
    "issue_id": { "type": "string", "pattern": "^issue:[0-9A-HJKMNP-TV-Z]{26}$" },
    "issue_version": { "type": "integer", "minimum": 1 },
    "issue_key": { "$ref": "#/$defs/Hash" },
    "binding": { "$ref": "#/$defs/VersionBinding" },
    "type": {
      "enum": [
        "constraint_violation", "missing_requirement", "wrong_target", "missing_verification",
        "goal_change", "insufficient_evidence", "stall_or_regression_candidate",
        "experience_applicability"
      ]
    },
    "state": {
      "enum": ["proposed", "open", "needs_evidence", "judged", "abstained", "closed", "stale_goal", "rejected"]
    },
    "subject_key": { "type": "string", "minLength": 1, "maxLength": 512 },
    "question_text": { "type": ["string", "null"], "maxLength": 512 },
    "requirement_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "artifact_paths": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "artifact_versions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "version"],
        "properties": { "path": { "type": "string" }, "version": { "type": "string" } }
      }
    },
    "contract_required": { "type": "boolean" },
    "contract_paths": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string" } },
    "trigger": { "$ref": "#/$defs/IssueTrigger" },
    "source_event_ids": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string" }
    },
    "source_refs": { "$ref": "#/$defs/SourceRefs" },
    "evidence_gap": { "type": "array", "items": { "$ref": "#/$defs/EvidenceGap" } },
    "confirmation": { "$ref": "#/$defs/IssueConfirmation" },
    "judgment_ref": { "type": ["string", "null"], "pattern": "^judg:[0-9A-HJKMNP-TV-Z]{26}$" },
    "close_evidence": { "$ref": "#/$defs/CloseEvidence" },
    "review_handoff_closure": { "$ref": "#/$defs/ReviewHandoffClosure" },
    "experience_ref": { "$ref": "#/$defs/ExperienceRef" },
    "reopen_count": { "type": "integer", "minimum": 0 },
    "previous_issue_id": { "type": ["string", "null"], "pattern": "^issue:[0-9A-HJKMNP-TV-Z]{26}$" },
    "rejection": { "$ref": "#/$defs/Rejection" },
    "opened_at_watermark": { "type": "integer", "minimum": 0 },
    "last_observed_watermark": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "integer", "minimum": 0 },
    "last_transition_id": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "SourceRef": {
      "type": "string",
      "pattern": "^(journal://ev:[0-9A-HJKMNP-TV-Z]{26}|blob://sha256:[0-9a-f]{64})#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
    },
    "SourceRefs": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/SourceRef" }
    },
    "VersionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "branch_id", "input_epoch", "goal_version", "config_version", "watermark"],
      "properties": {
        "task_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "input_epoch": { "type": "integer", "minimum": 1 },
        "goal_version": { "type": "string" },
        "config_version": { "type": "string" },
        "watermark": { "type": "integer", "minimum": 0 }
      }
    },
    "IssueTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event_ids", "detector_id", "detector_version"],
      "properties": {
        "kind": {
          "enum": ["deterministic_check", "user_feedback", "completion_claim", "stable_boundary", "progress_signal", "ledger_correction", "review_snapshot"]
        },
        "event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "detector_id": { "type": "string", "minLength": 1 },
        "detector_version": { "type": "string", "minLength": 1 }
      }
    },
    "EvidenceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "requirement_ids", "source_refs", "affects_question_keys"],
      "properties": {
        "code": {
          "enum": ["source_unretrievable", "interface_contract_missing", "artifact_version_unknown", "verifier_absent", "counterevidence_not_searched", "capture_gap", "template_role_unresolved", "authorization_not_local", "conflicting_sources"]
        },
        "requirement_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "source_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/SourceRef" } },
        "affects_question_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "IssueConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence_ids", "source_refs", "confirmed_at_watermark"],
      "properties": {
        "kind": { "enum": ["human_input", "verified_fact", "coverage_gap", "stable_signal", "review_snapshot"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } },
        "confirmed_at_watermark": { "type": "integer", "minimum": 0 }
      }
    },
    "SourceHashEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "content_hash"],
      "properties": { "source_ref": { "$ref": "#/$defs/SourceRef" }, "content_hash": { "$ref": "#/$defs/Hash" } }
    },
    "ReviewHandoffPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "handoff_hash", "proposal_id", "proposal_hash", "decision", "review_match_outcome", "snapshot_id", "snapshot_hash", "plan_id", "plan_hash", "question_key", "close_payload_hash"],
      "properties": {
        "handoff_id": { "type": "string" },
        "handoff_hash": { "$ref": "#/$defs/Hash" },
        "proposal_id": { "type": "string" },
        "proposal_hash": { "$ref": "#/$defs/Hash" },
        "decision": { "enum": ["proceed", "unverified"] },
        "review_match_outcome": { "enum": ["applicable", "conflict", "unknown", "not_applicable", null] },
        "snapshot_id": { "type": "string" },
        "snapshot_hash": { "$ref": "#/$defs/Hash" },
        "plan_id": { "type": "string" },
        "plan_hash": { "$ref": "#/$defs/Hash" },
        "question_key": { "$ref": "#/$defs/Hash" },
        "close_payload_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "CloseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence_id", "source_refs", "source_hashes", "evidence_hash", "goal_version", "recorded_at_watermark", "requirement_ids", "artifact_version", "verifier_ref", "review_handoff"],
      "properties": {
        "kind": { "enum": ["verified_behavior", "verified_artifact", "human_acceptance", "coverage_completion", "review_handoff"] },
        "evidence_id": { "type": "string" },
        "source_refs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/SourceRef" } },
        "source_hashes": { "type": "array", "items": { "$ref": "#/$defs/SourceHashEntry" } },
        "evidence_hash": { "$ref": "#/$defs/Hash" },
        "goal_version": { "type": "string" },
        "recorded_at_watermark": { "type": "integer", "minimum": 0 },
        "requirement_ids": { "type": "array", "items": { "type": "string" } },
        "artifact_version": { "type": ["string", "null"] },
        "verifier_ref": { "type": ["string", "null"] },
        "review_handoff": { "anyOf": [{ "$ref": "#/$defs/ReviewHandoffPayload" }, { "type": "null" }] }
      }
    },
    "ReviewHandoffClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_id", "handoff_hash", "proposal_id", "proposal_hash", "decision", "review_match_outcome", "closure_disposition", "snapshot_id", "snapshot_hash", "plan_id", "plan_hash", "question_key"],
      "properties": {
        "handoff_id": { "type": "string" },
        "handoff_hash": { "$ref": "#/$defs/Hash" },
        "proposal_id": { "type": "string" },
        "proposal_hash": { "$ref": "#/$defs/Hash" },
        "decision": { "enum": ["proceed", "unverified"] },
        "review_match_outcome": { "enum": ["applicable", "conflict", "unknown", "not_applicable", null] },
        "closure_disposition": { "enum": ["handoff_proceed", "handoff_unverified"] },
        "snapshot_id": { "type": "string" },
        "snapshot_hash": { "$ref": "#/$defs/Hash" },
        "plan_id": { "type": "string" },
        "plan_hash": { "$ref": "#/$defs/Hash" },
        "question_key": { "$ref": "#/$defs/Hash" }
      }
    },
    "ExperienceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_hash", "proposal_id", "proposal_hash", "experience_id", "experience_version", "experience_content_hash"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "snapshot_hash": { "$ref": "#/$defs/Hash" },
        "proposal_id": { "type": "string" },
        "proposal_hash": { "$ref": "#/$defs/Hash" },
        "experience_id": { "type": "string" },
        "experience_version": { "type": "integer", "minimum": 1 },
        "experience_content_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "Rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs"],
      "properties": {
        "kind": { "enum": ["candidate_unconfirmed", "ledger_correction", "requirement_retracted", "duplicate_merged", "review_handoff_terminal"] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } }
      }
    }
  }
}
