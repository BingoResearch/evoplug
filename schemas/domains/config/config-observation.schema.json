{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:config_observation:1",
  "title": "ObservationRecord",
  "description": "One observation sample for a config trial (DD-CFG-143, DD-CFG-188).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "trial_id", "sample_id", "observed_at", "trigger",
    "telemetry", "probe", "guardrails", "evidence_ref", "record_hash"
  ],
  "properties": {
    "schema_version": { "const": "rsi.config_observation/1" },
    "trial_id": { "type": "string", "pattern": "^ctr:[0-9A-HJKMNP-TV-Z]{26}$" },
    "sample_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "observed_at": { "type": "integer", "minimum": 0 },
    "trigger": { "type": "boolean" },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "trigger_data_present"],
      "properties": { "complete": { "type": "boolean" }, "trigger_data_present": { "type": "boolean" } }
    },
    "probe": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/EffectiveProbe" }] },
    "guardrails": { "type": "array", "items": { "$ref": "#/$defs/GuardrailValue" } },
    "evidence_ref": { "$ref": "#/$defs/SourceRef" },
    "record_hash": { "$ref": "#/$defs/Hash" }
  },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "SourceRef": { "type": "string", "pattern": "^(journal://[^#]+|blob://sha256:[0-9a-f]{64})#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$" },
    "FieldId": { "type": "string", "pattern": "^fld:[0-9A-HJKMNP-TV-Z]{26}$" },
    "ConfigScalar": { "type": ["string", "number", "boolean", "null"] },
    "ConfigPath": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "format", "root", "relative_path", "pointer", "create"], "properties": { "kind": { "const": "file" }, "format": { "enum": ["json", "jsonc", "yaml", "toml"] }, "root": { "enum": ["user", "project", "managed", "session"] }, "relative_path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "pointer": { "type": "string" }, "create": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "api_id", "key_path", "merge", "readback"], "properties": { "kind": { "const": "settings_api" }, "api_id": { "const": "openhands_server_settings" }, "key_path": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "merge": { "const": "deep_merge" }, "readback": { "const": "api_get" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "setter_id", "scope"], "properties": { "kind": { "const": "setter" }, "setter_id": { "type": "string", "minLength": 1 }, "scope": { "enum": ["session", "agent"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "env" }, "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" } } }
      ]
    },
    "AssignmentValue": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["presence", "value"], "properties": { "presence": { "const": "present" }, "value": { "$ref": "#/$defs/ConfigScalar" } } },
        { "type": "object", "additionalProperties": false, "required": ["presence"], "properties": { "presence": { "const": "absent" } } }
      ]
    },
    "FieldAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "path", "value"],
      "properties": { "field_id": { "$ref": "#/$defs/FieldId" }, "path": { "$ref": "#/$defs/ConfigPath" }, "value": { "$ref": "#/$defs/AssignmentValue" } }
    },
    "EffectiveProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "resolved", "evidence_ref", "repeat_count", "baseline_explainable", "observed_at"],
      "properties": {
        "source": { "enum": ["host_resolved_config", "runtime_log_resolved", "behavior_signature"] },
        "resolved": { "type": "array", "items": { "$ref": "#/$defs/FieldAssignment" } },
        "evidence_ref": { "$ref": "#/$defs/SourceRef" },
        "repeat_count": { "type": "integer", "minimum": 0 },
        "baseline_explainable": { "type": "boolean" },
        "observed_at": { "type": "integer", "minimum": 0 }
      }
    },
    "GuardrailValue": {
      "type": "object", "additionalProperties": false,
      "required": ["guardrail_id", "metric_id", "value", "status", "sample_count", "evidence_ref"],
      "properties": {
        "guardrail_id": { "enum": ["context_overflow", "compaction_failure", "quality_independent", "cost_per_success", "safety_zero"] },
        "metric_id": { "enum": ["acceptance_pass_rate", "task_success_rate", "compaction_events_per_session", "prompt_tokens_p95", "billed_tokens_per_success", "cost_usd_per_success", "context_overflow_count", "compaction_failure_count", "forbidden_write_count"] },
        "value": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "status": { "enum": ["ok", "breached", "unknown"] },
        "sample_count": { "type": "integer", "minimum": 0 },
        "evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/SourceRef" }] }
      }
    }
  }
}
