{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:field_registry_snapshot:1",
  "title": "FieldRegistrySnapshot",
  "description": "Content-addressed registry snapshot (DD-CFG-034, DD-CFG-182).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "registry_version", "host_id", "source_pin", "binary_pin",
    "adapter_version", "config_space", "mapping", "mode", "construction_path",
    "model_scope", "model_scope_key", "field_specs", "deny_rules", "created_at",
    "snapshot_hash"
  ],
  "properties": {
    "schema_version": { "const": "rsi.field_registry_snapshot/1" },
    "registry_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "host_id": { "enum": ["pi", "oh-my-pi", "step-code", "codex", "opencode", "openhands-sdk", "claude-code"] },
    "source_pin": { "$ref": "#/$defs/SourcePin" },
    "binary_pin": { "$ref": "#/$defs/BinaryPin" },
    "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "config_space": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "mapping": { "enum": ["exact", "partial", "unmapped"] },
    "mode": { "enum": ["interactive", "print", "rpc", "acp", "sdk", "sdk_stdio", "exec", "app-server", "server", "local_conversation", "remote_conversation"] },
    "construction_path": { "enum": ["cli", "sdk", "rpc", "app_server", "acp", "sdk_stdio", "server", "server_settings", "direct_agent", "preset_agent", "subagent_factory"] },
    "model_scope": { "$ref": "#/$defs/ModelScope" },
    "model_scope_key": { "type": "string", "minLength": 1, "maxLength": 512 },
    "field_specs": { "type": "array", "items": { "$ref": "#/$defs/FieldSpec" } },
    "deny_rules": { "type": "array", "items": { "$ref": "#/$defs/DenyRule" } },
    "created_at": { "type": "integer", "minimum": 0 },
    "snapshot_hash": { "$ref": "#/$defs/Hash" }
  },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "SourceRef": { "type": "string", "pattern": "^(journal://[^#]+|blob://sha256:[0-9a-f]{64})#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$" },
    "SourcePin": {
      "type": "object", "additionalProperties": false,
      "required": ["host_version", "host_version_kind", "source_commit"],
      "properties": {
        "host_version": { "type": "string", "minLength": 1 },
        "host_version_kind": { "enum": ["release", "source_commit", "binary_hash"] },
        "source_commit": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "BinaryPin": {
      "type": "object", "additionalProperties": false,
      "required": ["binary_version", "binary_hash"],
      "properties": {
        "binary_version": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "binary_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hash" }] }
      }
    },
    "ModelScope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "any" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "provider", "model_pattern"], "properties": { "kind": { "const": "family" }, "provider": { "type": "string", "minLength": 1 }, "model_pattern": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "provider", "model_id", "variant"], "properties": { "kind": { "const": "exact" }, "provider": { "type": "string", "minLength": 1 }, "model_id": { "type": "string", "minLength": 1 }, "variant": { "oneOf": [{ "type": "null" }, { "type": "string" }] } } }
      ]
    },
    "DenyRule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "authorization_class", "match"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorization_class": { "enum": ["forbidden_credentials", "forbidden_permissions", "forbidden_sandbox", "forbidden_shared_budget", "forbidden_evoplug_policy", "forbidden_managed_policy"] },
        "match": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind", "segments"], "properties": { "kind": { "enum": ["path_exact", "path_prefix"] }, "segments": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "env_name" }, "name": { "type": "string", "minLength": 1 } } }
          ]
        }
      }
    },
    "FieldSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "field_id", "field_key", "host_id", "source_pin", "binary_pin",
        "adapter_version", "config_space", "mapping", "mode", "construction_path",
        "model_scope", "model_scope_key", "value_schema", "unit", "default_spec",
        "source_layers", "precedence", "coupling_group", "normalization_id",
        "apply_boundaries", "readback", "guardrail_profile_id", "window_profile_id",
        "rollback_profile_id", "authorization_class", "status", "status_reason",
        "provenance", "spec_hash"
      ],
      "properties": {
        "schema_version": { "const": "rsi.field_spec/1" },
        "field_id": { "type": "string", "pattern": "^fld:[0-9A-HJKMNP-TV-Z]{26}$" },
        "field_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "host_id": { "enum": ["pi", "oh-my-pi", "step-code", "codex", "opencode", "openhands-sdk", "claude-code"] },
        "source_pin": { "$ref": "#/$defs/SourcePin" },
        "binary_pin": { "$ref": "#/$defs/BinaryPin" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "config_space": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "mapping": { "enum": ["exact", "partial", "unmapped"] },
        "mode": { "enum": ["interactive", "print", "rpc", "acp", "sdk", "sdk_stdio", "exec", "app-server", "server", "local_conversation", "remote_conversation"] },
        "construction_path": { "enum": ["cli", "sdk", "rpc", "app_server", "acp", "sdk_stdio", "server", "server_settings", "direct_agent", "preset_agent", "subagent_factory"] },
        "model_scope": { "$ref": "#/$defs/ModelScope" },
        "model_scope_key": { "type": "string", "minLength": 1, "maxLength": 512 },
        "value_schema": { "type": "object" },
        "unit": { "enum": ["none", "tokens", "percent", "ratio", "ms", "model_ref", "effort_level"] },
        "default_spec": { "type": "object" },
        "source_layers": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "precedence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "coupling_group": { "oneOf": [{ "type": "null" }, { "enum": ["omp_threshold_mode", "codex_compaction_limits", "step_clm_projection", "opencode_keep_tokens", "openhands_condenser", "claude_autocompact"] }] },
        "normalization_id": { "enum": ["identity", "percent_token_floor_v1", "omp_threshold_mode_v1", "step_clm_projection_v1", "codex_compaction_limits_v1", "claude_autocompact_window_v1", "pi_model_override_guard", "opencode_keep_tokens_v1", "openhands_condenser_v1"] },
        "apply_boundaries": { "type": "array", "minItems": 1, "items": { "enum": ["next_request", "next_session", "conversation_start", "reload", "config_watch", "process_restart", "setter_immediate", "app_server_thread"] } },
        "readback": { "type": "object" },
        "guardrail_profile_id": { "const": "G1" },
        "window_profile_id": { "enum": ["W1", "W2"] },
        "rollback_profile_id": { "const": "R1" },
        "authorization_class": { "enum": ["trialable", "host_capacity", "forbidden_credentials", "forbidden_permissions", "forbidden_sandbox", "forbidden_shared_budget", "forbidden_evoplug_policy", "forbidden_managed_policy"] },
        "status": { "enum": ["active", "h_unverified", "source_only", "unsupported"] },
        "status_reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceRef" } },
        "spec_hash": { "$ref": "#/$defs/Hash" }
      }
    }
  }
}
