{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:config_space_snapshot:1",
  "title": "ConfigSpaceSnapshot",
  "description": "Call-time, non-durable baseline snapshot (DD-CFG-191).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config_space", "values", "files", "config_version", "semantic_hash", "captured_at"],
  "properties": {
    "schema_version": { "const": "rsi.config_space_snapshot/1" },
    "config_space": { "$ref": "#/$defs/ConfigSpaceRef" },
    "values": { "type": "array", "items": { "$ref": "#/$defs/FieldAssignment" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/FileState" } },
    "config_version": { "type": "string", "minLength": 1 },
    "semantic_hash": { "$ref": "#/$defs/Hash" },
    "captured_at": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "SourceRef": { "type": "string", "pattern": "^(journal://[^#]+|blob://sha256:[0-9a-f]{64})#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$" },
    "ConfigScalar": { "type": ["string", "number", "boolean", "null"] },
    "ConfigPath": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "format", "root", "relative_path", "pointer", "create"], "properties": { "kind": { "const": "file" }, "format": { "enum": ["json", "jsonc", "yaml", "toml"] }, "root": { "enum": ["user", "project", "managed", "session"] }, "relative_path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "pointer": { "type": "string" }, "create": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "api_id", "key_path", "merge", "readback"], "properties": { "kind": { "const": "settings_api" }, "api_id": { "const": "openhands_server_settings" }, "key_path": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "merge": { "const": "deep_merge" }, "readback": { "const": "api_get" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "setter_id", "scope"], "properties": { "kind": { "const": "setter" }, "setter_id": { "type": "string", "minLength": 1 }, "scope": { "enum": ["session", "agent"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "env" }, "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" } } }
      ]
    },
    "ConfigFilePath": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "format", "root", "relative_path", "pointer", "create"],
      "properties": {
        "kind": { "const": "file" },
        "format": { "enum": ["json", "jsonc", "yaml", "toml"] },
        "root": { "enum": ["user", "project", "managed", "session"] },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "pointer": { "type": "string" },
        "create": { "type": "boolean" }
      }
    },
    "AssignmentValue": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["presence", "value"], "properties": { "presence": { "const": "present" }, "value": { "$ref": "#/$defs/ConfigScalar" } } },
        { "type": "object", "additionalProperties": false, "required": ["presence"], "properties": { "presence": { "const": "absent" } } }
      ]
    },
    "FieldAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "path", "value"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^fld:[0-9A-HJKMNP-TV-Z]{26}$" },
        "path": { "$ref": "#/$defs/ConfigPath" },
        "value": { "$ref": "#/$defs/AssignmentValue" }
      }
    },
    "SourcePin": {
      "type": "object", "additionalProperties": false,
      "required": ["host_version", "host_version_kind", "source_commit"],
      "properties": {
        "host_version": { "type": "string", "minLength": 1 },
        "host_version_kind": { "enum": ["release", "source_commit", "binary_hash"] },
        "source_commit": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "BinaryPin": {
      "type": "object", "additionalProperties": false,
      "required": ["binary_version", "binary_hash"],
      "properties": {
        "binary_version": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
        "binary_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hash" }] }
      }
    },
    "RootIdentityPin": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "root_id", "identity_kind", "device_id", "file_id"],
      "properties": {
        "schema_version": { "const": "rsi.root_identity/1" },
        "root_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "identity_kind": { "enum": ["dev_inode", "file_id"] },
        "device_id": { "type": "string", "minLength": 1 },
        "file_id": { "type": "string", "minLength": 1 }
      }
    },
    "ModelRef": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "variant", "resolution_source"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "variant": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "resolution_source": { "enum": ["host_readback", "explicit"] }
      }
    },
    "HostBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["host_id", "source_pin", "binary_pin", "adapter_version", "subject", "mode", "config_space", "root_id", "execution_environment", "mapping", "capability_binding_key", "capability_snapshot_hash", "model", "construction_path"],
      "properties": {
        "host_id": { "enum": ["pi", "oh-my-pi", "step-code", "codex", "opencode", "openhands-sdk", "claude-code"] },
        "source_pin": { "$ref": "#/$defs/SourcePin" },
        "binary_pin": { "$ref": "#/$defs/BinaryPin" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "subject": { "const": "product_adapter" },
        "mode": { "enum": ["interactive", "print", "rpc", "acp", "sdk", "sdk_stdio", "exec", "app-server", "server", "local_conversation", "remote_conversation"] },
        "config_space": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "root_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "execution_environment": { "type": "object", "additionalProperties": false, "required": ["os", "arch", "isolation"], "properties": { "os": { "type": "string", "minLength": 1 }, "arch": { "type": "string", "minLength": 1 }, "isolation": { "enum": ["local", "container", "remote"] } } },
        "mapping": { "enum": ["exact", "partial", "unmapped"] },
        "capability_binding_key": { "$ref": "#/$defs/Hash" },
        "capability_snapshot_hash": { "$ref": "#/$defs/Hash" },
        "model": { "$ref": "#/$defs/ModelRef" },
        "construction_path": { "enum": ["cli", "sdk", "rpc", "app_server", "acp", "sdk_stdio", "server", "server_settings", "direct_agent", "preset_agent", "subagent_factory"] }
      }
    },
    "ConfigSpaceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["config_space_id", "host", "root_id", "root_identity_pin", "source_layer_set_hash", "config_version", "semantic_hash"],
      "properties": {
        "config_space_id": { "$ref": "#/$defs/Hash" },
        "host": { "$ref": "#/$defs/HostBinding" },
        "root_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "root_identity_pin": { "$ref": "#/$defs/RootIdentityPin" },
        "source_layer_set_hash": { "$ref": "#/$defs/Hash" },
        "config_version": { "type": "string", "minLength": 1 },
        "semantic_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "FileState": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "exists", "content_hash", "semantic_hash", "parser_id", "parser_version"],
      "properties": {
        "path": { "$ref": "#/$defs/ConfigFilePath" },
        "exists": { "type": "boolean" },
        "content_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hash" }] },
        "semantic_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Hash" }] },
        "parser_id": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
