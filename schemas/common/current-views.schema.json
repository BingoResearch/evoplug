{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:current_goal_view:1",
  "title": "CurrentGoalView",
  "description": "Read-port views for the branch current goal and the active config version (DD-FND-031.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "branch_id", "goal_version", "goal_revision", "goal_snapshot_id", "observed_watermark"],
  "properties": {
    "schema_version": { "const": "rsi.current_goal_view/1" },
    "task_id": { "type": "string", "pattern": "^task:[0-9A-HJKMNP-TV-Z]{26}$" },
    "branch_id": { "type": "string", "pattern": "^br:[0-9A-HJKMNP-TV-Z]{26}$" },
    "goal_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "goal_revision": { "type": "integer", "minimum": 1 },
    "goal_snapshot_id": { "type": ["string", "null"] },
    "observed_watermark": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "$defs": {
    "Hash": { "title": "Hash", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ConfigVersionView": {
      "title": "ConfigVersionView",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "config_space", "config_version", "content_hash"],
      "properties": {
        "schema_version": { "const": "rsi.config_version_view/1" },
        "config_space": { "type": "string", "minLength": 1, "maxLength": 128 },
        "config_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
        "content_hash": { "$ref": "#/$defs/Hash" }
      }
    }
  }
}
