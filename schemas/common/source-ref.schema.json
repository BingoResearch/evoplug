{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:source_ref:1",
  "title": "SourceRef",
  "description": "Immutable content address with a half-open UTF-8 byte range (DD-FND-032). Range arithmetic and hash verification are domain logic.",
  "oneOf": [
    { "$ref": "#/$defs/JournalSourceRef" },
    { "$ref": "#/$defs/BlobSourceRef" }
  ],
  "$defs": {
    "JournalSourceRef": {
      "title": "JournalSourceRef",
      "type": "string",
      "pattern": "^journal://ev:[0-9A-HJKMNP-TV-Z]{26}#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
    },
    "BlobSourceRef": {
      "title": "BlobSourceRef",
      "type": "string",
      "pattern": "^blob://sha256:[0-9a-f]{64}#bytes=(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
    }
  }
}
