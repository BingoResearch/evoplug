{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoplug:schema:write_intent_row:1",
  "title": "WriteIntentRow",
  "description": "Physical managed-write rows (DD-FND-056/091). Physical paths stay relative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["write_id", "idempotency_key", "grant_id", "action", "object_type", "candidate_id", "candidate_hash", "binding_json", "scope_kind", "scope_ref_id", "project_id", "config_space_id", "scope_hash", "target_ownership", "root_id", "root_identity_pin_json", "root_registration_hash", "target_path", "write_mode", "block_action", "block_selector", "expected_file_hash", "expected_block_hash", "snapshot_id", "rollback_of_write_id", "target_snapshot_id", "target_snapshot_hash", "atomicity", "exclusion", "unattended_policy", "state", "attempt", "last_error_code", "row_version", "created_at", "updated_at"],
  "properties": {
    "write_id": { "type": "string", "pattern": "^wi:[0-9A-HJKMNP-TV-Z]{26}$" },
    "idempotency_key": { "type": "string" },
    "grant_id": { "type": "string" },
    "action": { "enum": ["create", "update", "disable", "rollback"] },
    "object_type": { "enum": ["skill", "memory", "instructions"] },
    "candidate_id": { "type": "string" },
    "candidate_hash": { "$ref": "#/$defs/Hash" },
    "binding_json": { "type": "string" },
    "scope_kind": { "enum": ["task", "session"] },
    "scope_ref_id": { "type": "string" },
    "project_id": { "type": ["string", "null"] },
    "config_space_id": { "type": ["string", "null"] },
    "scope_hash": { "$ref": "#/$defs/Hash" },
    "target_ownership": { "enum": ["native_managed", "rsi_managed", "shared_handwritten"] },
    "root_id": { "type": "string" },
    "root_identity_pin_json": { "type": "string" },
    "root_registration_hash": { "$ref": "#/$defs/Hash" },
    "target_path": { "type": "string" },
    "write_mode": { "enum": ["whole_file", "managed_block"] },
    "block_action": { "type": ["string", "null"] },
    "block_selector": { "type": ["string", "null"] },
    "expected_file_hash": { "type": ["string", "null"] },
    "expected_block_hash": { "type": ["string", "null"] },
    "snapshot_id": { "type": ["string", "null"] },
    "rollback_of_write_id": { "type": ["string", "null"] },
    "target_snapshot_id": { "type": ["string", "null"] },
    "target_snapshot_hash": { "type": ["string", "null"] },
    "atomicity": { "enum": ["native_atomic", "single_file_atomic", "none"] },
    "exclusion": { "enum": ["native_cooperative", "rsi_advisory", "none"] },
    "unattended_policy": { "enum": ["auto_allowed", "pending_approval", "rsi_managed_file_only"] },
    "state": { "enum": ["intent_recorded", "snapshot_written", "temp_written", "renamed", "dir_synced", "verified", "pending_approval", "conflict", "path_rejected", "write_failed", "partial", "recovery_required"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "last_error_code": { "type": ["string", "null"] },
    "row_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "Hash": { "title": "Hash", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "WriteSnapshotRow": {
      "title": "WriteSnapshotRow",
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "write_id", "path", "write_mode", "file_hash", "file_byte_length", "block_action", "block_selector", "block_start", "block_byte_length", "block_content_hash", "block_hash", "content_ref", "snapshot_hash", "created_at"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "write_id": { "type": "string" },
        "path": { "type": "string" },
        "write_mode": { "enum": ["whole_file", "managed_block"] },
        "file_hash": { "$ref": "#/$defs/Hash" },
        "file_byte_length": { "type": "integer", "minimum": 0 },
        "block_action": { "type": ["string", "null"] },
        "block_selector": { "type": ["string", "null"] },
        "block_start": { "type": ["integer", "null"], "minimum": 0 },
        "block_byte_length": { "type": ["integer", "null"], "minimum": 0 },
        "block_content_hash": { "type": ["string", "null"] },
        "block_hash": { "type": ["string", "null"] },
        "content_ref": { "type": "string" },
        "snapshot_hash": { "$ref": "#/$defs/Hash" },
        "created_at": { "type": "integer", "minimum": 0 }
      }
    },
    "WriteResultRow": {
      "title": "WriteResultRow",
      "type": "object",
      "additionalProperties": false,
      "required": ["write_id", "attempt", "state", "root_id", "path", "new_file_hash", "new_block_hash", "snapshot_id", "target_snapshot_id", "target_snapshot_hash", "three_way_diff_ref", "readback_verified", "atomicity", "exclusion", "unattended_policy", "error_code", "completed_at"],
      "properties": {
        "write_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "state": { "type": "string" },
        "root_id": { "type": "string" },
        "path": { "type": "string" },
        "new_file_hash": { "type": ["string", "null"] },
        "new_block_hash": { "type": ["string", "null"] },
        "snapshot_id": { "type": ["string", "null"] },
        "target_snapshot_id": { "type": ["string", "null"] },
        "target_snapshot_hash": { "type": ["string", "null"] },
        "three_way_diff_ref": { "type": ["string", "null"] },
        "readback_verified": { "type": "integer", "enum": [0, 1] },
        "atomicity": { "enum": ["native_atomic", "single_file_atomic", "none"] },
        "exclusion": { "enum": ["native_cooperative", "rsi_advisory", "none"] },
        "unattended_policy": { "enum": ["auto_allowed", "pending_approval", "rsi_managed_file_only"] },
        "error_code": { "type": ["string", "null"] },
        "completed_at": { "type": ["integer", "null"] }
      }
    }
  }
}
