{
  "name": "evoplug-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "install:locked": "pnpm install --frozen-lockfile",
    "bootstrap": "node tools/schema-codegen/cli.mjs --write",
    "build": "node tools/schema-codegen/cli.mjs --check && tsc -b tsconfig.build.json && node tools/kernel-bundle/cli.mjs",
    "bundle:kernel": "node tools/kernel-bundle/cli.mjs",
    "typecheck": "tsc -b tsconfig.build.json --pretty false && node tools/kernel-bundle/cli.mjs && tsc -p adapters/tsconfig.runtime.json --pretty false",
    "schema:generate": "node tools/schema-codegen/cli.mjs --write",
    "schema:check": "node tools/schema-codegen/cli.mjs --check",
    "schema:check:ddl": "node tools/schema-codegen/cli.mjs --check-ddl",
    "lint:boundaries": "node tools/check-boundaries/cli.mjs",
    "adapter:manifest": "node tools/adapter-manifest/cli.mjs --check",
    "adapter:manifest:write": "node tools/adapter-manifest/cli.mjs --write",
    "evolve": "node tools/test-cli/cli.mjs",
    "test": "node tools/test-cli/cli.mjs test --suite all",
    "test:unit": "node tools/test-cli/cli.mjs test --suite unit",
    "test:functional": "node tools/test-cli/cli.mjs test --suite functional",
    "test:integration": "node tools/test-cli/cli.mjs test --suite integration",
    "test:fault": "node tools/test-cli/cli.mjs test --suite fault",
    "check": "pnpm install:locked && pnpm schema:check && pnpm schema:check:ddl && pnpm lint:boundaries && pnpm adapter:manifest && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@evoplug/adapter-claude-code": "workspace:*",
    "@evoplug/adapter-codex": "workspace:*",
    "@evoplug/adapter-kit": "workspace:*",
    "@evoplug/adapter-oh-my-pi": "workspace:*",
    "@evoplug/adapter-opencode": "workspace:*",
    "@evoplug/adapter-openhands-sdk": "workspace:*",
    "@evoplug/adapter-pi": "workspace:*",
    "@evoplug/adapter-step-code": "workspace:*",
    "@evoplug/app-kernel": "workspace:*",
    "@evoplug/auth": "workspace:*",
    "@evoplug/budget": "workspace:*",
    "@evoplug/cli": "workspace:*",
    "@evoplug/core": "workspace:*",
    "@evoplug/delivery": "workspace:*",
    "@evoplug/egress": "workspace:*",
    "@evoplug/evidence": "workspace:*",
    "@evoplug/host-runtime": "workspace:*",
    "@evoplug/ipc": "workspace:*",
    "@evoplug/kernel": "workspace:*",
    "@evoplug/ledger": "workspace:*",
    "@evoplug/replay": "workspace:*",
    "@evoplug/review": "workspace:*",
    "@evoplug/storage": "workspace:*",
    "@evoplug/test-support": "workspace:*",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
